  "mermaidCatalogTemplateFlowchart": "graph TD\n  A[Inicio]\n  B[Procesar paso]\n  C<MERMAID_OPEN_BRACE>Condición<MERMAID_CLOSE_BRACE>\n  D[Fin]\n\n  A --> B\n  B --> C\n  C -->|Sí| D\n  C -->|No| B",
  "mermaidCatalogTemplateSequenceDiagram": "sequenceDiagram\n  participant \"Usuario\" as user\n  participant \"Sistema\" as system\n  participant \"Base de datos\" as database\n\n  user->>system: Enviar solicitud\n  system->>database: Consultar datos\n  database-->>system: Devolver resultado\n  system-->>user: Mostrar resultado",
  "mermaidCatalogTemplateClassDiagram": "classDiagram\n  class Person <MERMAID_OPEN_BRACE>\n    +String nombre\n    +int edad\n    +getName() String\n    +setName(String nombre) void\n  <MERMAID_CLOSE_BRACE>\n  class Student <MERMAID_OPEN_BRACE>\n    +String studentId\n    +study() void\n  <MERMAID_CLOSE_BRACE>\n  class Teacher <MERMAID_OPEN_BRACE>\n    +String teacherId\n    +teach() void\n  <MERMAID_CLOSE_BRACE>\n  Student --|> Person\n  Teacher --|> Person",
  "mermaidCatalogTemplateStateDiagram": "stateDiagram-v2\n  state \"Pendiente\" as pending\n  state \"En proceso\" as processing\n  state \"Completado\" as completed\n  state \"Error\" as failed\n  [*] --> pending\n  pending --> processing\n  processing --> completed\n  processing --> failed\n  failed --> pending\n  completed --> [*]",
  "mermaidCatalogTemplateErDiagram": "erDiagram\n  CLIENTE ||--o<MERMAID_OPEN_BRACE> PEDIDO : realiza\n  PEDIDO ||--|<MERMAID_OPEN_BRACE> ARTICULO_PEDIDO : contiene\n  PRODUCTO ||--o<MERMAID_OPEN_BRACE> ARTICULO_PEDIDO : incluye\n  CLIENTE <MERMAID_OPEN_BRACE>\n    int id PK\n    string nombre\n    string correo\n  <MERMAID_CLOSE_BRACE>\n  PEDIDO <MERMAID_OPEN_BRACE>\n    int id PK\n    int id_cliente FK\n    date fecha_pedido\n  <MERMAID_CLOSE_BRACE>\n  PRODUCTO <MERMAID_OPEN_BRACE>\n    int id PK\n    string nombre\n    float precio\n  <MERMAID_CLOSE_BRACE>",
  "mermaidCatalogTemplateGantt": "gantt\n  title Cronograma del proyecto\n  dateFormat  YYYY-MM-DD\n  axisFormat  %m/%d\n\n  section Requisitos\n  Análisis de requisitos :a1, 2024-01-01, 14d\n  Diseño del prototipo   :a2, after a1, 10d\n\n  section Desarrollo\n  Desarrollo frontend   :b1, after a2, 20d\n  Desarrollo backend    :b2, after a2, 20d\n  Integración de API    :b3, after b1, 7d\n\n  section Pruebas\n  Pruebas funcionales   :c1, after b3, 10d\n  Despliegue            :c2, after c1, 3d",
  "mermaidCatalogTemplatePie": "pie showData\n  title Distribución de datos\n  \"Categoría A\" : 40\n  \"Categoría B\" : 25\n  \"Categoría C\" : 20\n  \"Categoría D\" : 15",
  "mermaidCatalogTemplateJourney": "journey\n  title Registro de usuario\n  section Registro\n    Abrir página de registro: 5: Usuario\n    Introducir datos: 3: Usuario\n    Enviar solicitud: 4: Usuario\n  section Verificación\n    Recibir código: 3: Sistema\n    Introducir código: 4: Usuario\n    Verificación correcta: 5: Sistema, Usuario",
  "mermaidCatalogTemplateGitGraph": "gitGraph\n  commit id: \"Commit inicial\"\n  commit id: \"Añadir función A\"\n  branch develop\n  checkout develop\n  commit id: \"Desarrollar función\"\n  commit id: \"Corregir error\"\n  checkout main\n  merge develop\n  commit id: \"Publicar v1.0\"",
  "mermaidCatalogTemplateMindmap": "mindmap\n  root((Gestión de proyectos))\n    Requisitos\n      Funcionales\n      No funcionales\n    Desarrollo\n      Frontend\n      Backend\n    Pruebas\n      Pruebas unitarias\n      Pruebas de integración\n    Despliegue\n      Entorno de pruebas\n      Entorno de producción",
  "mermaidCatalogTemplateTimeline": "timeline\n  title Hitos del proyecto\n  2024-Q1 : Análisis de requisitos : Plan confirmado\n  2024-Q2 : Desarrollo : Funciones implementadas\n  2024-Q3 : Pruebas : Corrección de errores : Optimización del rendimiento\n  2024-Q4 : Despliegue : Operación y mantenimiento",
  "mermaidCatalogTemplateBlock": "block-beta\n  columns 3\n  A[\"Requisitos\"] B[\"Desarrollo\"] C[\"Pruebas\"]\n  D[\"Despliegue\"] E[\"Operaciones\"] F[\"Supervisión\"]\n  A --> B\n  B --> C\n  C --> D\n  D --> E\n  E --> F",
  "mermaidCatalogTemplateRequirement": "requirementDiagram\n  requirement InicioSesion <MERMAID_OPEN_BRACE>\n    id: 1\n    text: El usuario puede iniciar sesión con su cuenta y contraseña\n    risk: medium\n    verifyMethod: test\n  <MERMAID_CLOSE_BRACE>\n  element PaginaInicio <MERMAID_OPEN_BRACE>\n    type: UI\n  <MERMAID_CLOSE_BRACE>\n  element ServicioAutenticacion <MERMAID_OPEN_BRACE>\n    type: Service\n  <MERMAID_CLOSE_BRACE>\n  PaginaInicio - satisfies -> InicioSesion\n  ServicioAutenticacion - verifies -> InicioSesion",
