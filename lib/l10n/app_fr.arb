  "mermaidCatalogTemplatePie": "pie showData\n  title Répartition des données\n  \"Catégorie A\" : 40\n  \"Catégorie B\" : 25\n  \"Catégorie C\" : 20\n  \"Catégorie D\" : 15",
  "mermaidCatalogTemplateJourney": "journey\n  title Inscription utilisateur\n  section Inscription\n    Ouvrir la page d’inscription: 5: Utilisateur\n    Saisir les informations: 3: Utilisateur\n    Envoyer la demande: 4: Utilisateur\n  section Vérification\n    Recevoir le code: 3: Système\n    Saisir le code: 4: Utilisateur\n    Vérification réussie: 5: Système, Utilisateur",
  "mermaidCatalogTemplateGitGraph": "gitGraph\n  commit id: \"Commit initial\"\n  commit id: \"Ajouter la fonctionnalité A\"\n  branch develop\n  checkout develop\n  commit id: \"Développer une nouvelle fonctionnalité\"\n  commit id: \"Corriger un bug\"\n  checkout main\n  merge develop\n  commit id: \"Publier la v1.0\"",
  "mermaidCatalogTemplateMindmap": "mindmap\n  root((Gestion de projet))\n    Exigences\n      Fonctionnelles\n      Non fonctionnelles\n    Développement\n      Frontend\n      Backend\n    Tests\n      Tests unitaires\n      Tests d’intégration\n    Déploiement\n      Environnement de test\n      Environnement de production",
  "mermaidCatalogTemplateTimeline": "timeline\n  title Jalons du projet\n  2024-Q1 : Étude des exigences : Plan confirmé\n  2024-Q2 : Développement : Fonctionnalités implémentées\n  2024-Q3 : Tests : Corrections de bugs : Optimisation des performances\n  2024-Q4 : Déploiement : Exploitation et maintenance",
