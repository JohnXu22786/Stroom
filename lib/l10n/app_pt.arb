  "mermaidCatalogTemplateFlowchart": "graph TD\n  A[Início]\n  B[Etapa do processo]\n  C<MERMAID_OPEN_BRACE>Condição<MERMAID_CLOSE_BRACE>\n  D[Fim]\n\n  A --> B\n  B --> C\n  C -->|Sim| D\n  C -->|Não| B",
  "mermaidCatalogTemplateSequenceDiagram": "sequenceDiagram\n  participant \"Usuário\" as user\n  participant \"Sistema\" as system\n  participant \"Banco de dados\" as database\n\n  user->>system: Enviar solicitação\n  system->>database: Consultar dados\n  database-->>system: Retornar resultado\n  system-->>user: Mostrar resultado",
  "mermaidCatalogTemplateClassDiagram": "classDiagram\n  class Person <MERMAID_OPEN_BRACE>\n    +String nome\n    +int idade\n    +getName() String\n    +setName(String nome) void\n  <MERMAID_CLOSE_BRACE>\n  class Student <MERMAID_OPEN_BRACE>\n    +String idEstudante\n    +study() void\n  <MERMAID_CLOSE_BRACE>\n  class Teacher <MERMAID_OPEN_BRACE>\n    +String idProfessor\n    +teach() void\n  <MERMAID_CLOSE_BRACE>\n  Student --|> Person\n  Teacher --|> Person",
  "mermaidCatalogTemplateStateDiagram": "stateDiagram-v2\n  state \"Pendente\" as pending\n  state \"Em processamento\" as processing\n  state \"Concluído\" as completed\n  state \"Falhou\" as failed\n  [*] --> pending\n  pending --> processing\n  processing --> completed\n  processing --> failed\n  failed --> pending\n  completed --> [*]",
  "mermaidCatalogTemplateErDiagram": "erDiagram\n  CLIENTE ||--o<MERMAID_OPEN_BRACE> PEDIDO : faz\n  PEDIDO ||--|<MERMAID_OPEN_BRACE> ITEM_PEDIDO : contém\n  PRODUTO ||--o<MERMAID_OPEN_BRACE> ITEM_PEDIDO : inclui\n  CLIENTE <MERMAID_OPEN_BRACE>\n    int id PK\n    string nome\n    string email\n  <MERMAID_CLOSE_BRACE>\n  PEDIDO <MERMAID_OPEN_BRACE>\n    int id PK\n    int id_cliente FK\n    date data_pedido\n  <MERMAID_CLOSE_BRACE>\n  PRODUTO <MERMAID_OPEN_BRACE>\n    int id PK\n    string nome\n    float preço\n  <MERMAID_CLOSE_BRACE>",
  "mermaidCatalogTemplateGantt": "gantt\n  title Cronograma do projeto\n  dateFormat  YYYY-MM-DD\n  axisFormat  %m/%d\n\n  section Requisitos\n  Análise de requisitos :a1, 2024-01-01, 14d\n  Projeto do protótipo   :a2, after a1, 10d\n\n  section Desenvolvimento\n  Desenvolvimento do frontend :b1, after a2, 20d\n  Desenvolvimento do backend  :b2, after a2, 20d\n  Integração da API            :b3, after b1, 7d\n\n  section Testes\n  Testes de funcionalidades    :c1, after b3, 10d\n  Implantação                  :c2, after c1, 3d",
  "mermaidCatalogTemplatePie": "pie showData\n  title Distribuição dos dados\n  \"Categoria A\" : 40\n  \"Categoria B\" : 25\n  \"Categoria C\" : 20\n  \"Categoria D\" : 15",
  "mermaidCatalogTemplateJourney": "journey\n  title Cadastro de usuário\n  section Inscrição\n    Abrir página de inscrição: 5: Usuário\n    Informar dados: 3: Usuário\n    Enviar solicitação: 4: Usuário\n  section Verificação\n    Receber código: 3: Sistema\n    Digitar código: 4: Usuário\n    Verificação concluída: 5: Sistema, Usuário",
